# Production origin. Leave unset for local development.
NEXT_PUBLIC_SITE_URL=

# Enquiry delivery. The From address needs a verified Resend domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional public alternative. Leave blank to use CONTACT_TO_EMAIL.
CONTACT_PUBLIC_EMAIL=
# Country code plus number, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Required for form delivery on Vercel production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional analytics. Vendor scripts load only after visitors opt in.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
